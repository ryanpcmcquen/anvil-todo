{
  "name": "anvil-todo-demo",
  "version": "0.0.1",
  "private": true,
  "description": "Demo TODO app using @anvil-di/anvil and @anvil-di/bellows for compile-time DI with an Express API and React frontend.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "generate:client": "tsx scripts/generate-client.ts",
    "generate": "vite build && pnpm generate:client",
    "dev:server": "tsx watch server/src/server.ts",
    "dev:client": "vite",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.app.json --noEmit",
    "typecheck": "pnpm typecheck:server && pnpm typecheck:client",
    "build": "vite build",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@anvil-di/anvil": "^0.0.3",
    "@anvil-di/anvil-unplugin": "^0.0.4",
    "@anvil-di/bellows": "^0.0.4",
    "@anvil-di/bellows-openapi": "^0.0.4",
    "@hey-api/client-fetch": "^0.9.0",
    "@tanstack/react-query": "^5.62.0",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.64.0",
    "@playwright/test": "^1.60.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
